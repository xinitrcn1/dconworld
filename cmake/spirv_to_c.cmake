# Wraps a SPIR-V binary into a C source and its header, so the shaders are
# compiled into the executable without their bytecode living in the repo.
#   cmake -DSPV=<in.spv> -DNAME=<symbol> -DOUT_C=<out.c> -DOUT_H=<out.h> -P spirv_to_c.cmake
# defines `const uint32_t <NAME>[]` (the words) and `const size_t <NAME>_size`
# (in bytes, what VkShaderModuleCreateInfo::codeSize wants)

file(READ "${SPV}" hex HEX)
string(LENGTH "${hex}" hex_len)
math(EXPR rem "${hex_len} % 8")
if(hex_len EQUAL 0 OR NOT rem EQUAL 0)
    message(FATAL_ERROR "${SPV} is not a SPIR-V binary (${hex_len} hex digits)")
endif()
math(EXPR size "${hex_len} / 2")

# little endian bytes into words, eight words a line
string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])" "0x\\4\\3\\2\\1, " words "${hex}")
# (CMake's regexes have no {8})
set(w "0x[0-9a-f]+, ")
string(REGEX REPLACE "(${w}${w}${w}${w}${w}${w}${w}${w})" "\\1\n    " words "${words}")
string(REGEX REPLACE " +\n" "\n" words "${words}")
string(REGEX REPLACE "[ \n]+$" "" words "${words}")

get_filename_component(header_name "${OUT_H}" NAME)
file(WRITE "${OUT_C}" "/* generated from ${SPV} by cmake/spirv_to_c.cmake, do not edit */
#include \"${header_name}\"

const uint32_t ${NAME}[] = {
    ${words}
};
const size_t ${NAME}_size = ${size};
")

file(WRITE "${OUT_H}" "/* generated by cmake/spirv_to_c.cmake, do not edit */
#pragma once
#include <stddef.h>
#include <stdint.h>

#ifdef __cplusplus
extern \"C\" {
#endif

extern const uint32_t ${NAME}[];
extern const size_t ${NAME}_size; /* bytes */

#ifdef __cplusplus
}
#endif
")
